diff --git a/tests/ops/test_mtp_draft_argmax.cpp b/tests/ops/test_mtp_draft_argmax.cpp
new file mode 100644
index 00000000..c6db08ca
--- /dev/null
+++ b/tests/ops/test_mtp_draft_argmax.cpp
@@ -0,0 +1,103 @@
+#include "ninfer/ops/mtp_draft_argmax.h"
+#include "core/device.h"
+#include "ops/op_tester.h"
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <iostream>
+#include <vector>
+
+using namespace ninfer;
+using namespace ninfer::test;
+
+namespace {
+struct Pair { float value; int id; };
+bool better(Pair a, Pair b) { return a.value > b.value || (a.value == b.value && a.id < b.id); }
+
+std::pair<int, int> oracle(const std::vector<std::uint16_t>& logits,
+                           const std::vector<std::int32_t>& counts,
+                           const ops::SamplingConfig& cfg,
+                           const std::vector<std::int32_t>& overlay) {
+    Pair first{-INFINITY, 0}, second{-INFINITY, 0};
+    for (int id = 0; id < static_cast<int>(logits.size()); ++id) {
+        const float raw = bf16_to_f32(logits[id]);
+        float value = raw;
+        if (std::isfinite(raw)) {
+            const int count = counts[id] + static_cast<int>(std::count(overlay.begin(), overlay.end(), id));
+            if (count > 0) value -= cfg.presence_penalty;
+            value -= cfg.frequency_penalty * static_cast<float>(count);
+        }
+        Pair c{value, id};
+        if (better(c, first)) { second = first; first = c; }
+        else if (id != first.id && better(c, second)) { second = c; }
+    }
+    return {first.id, second.id};
+}
+
+int run_case(std::vector<std::uint16_t> logits, std::vector<std::int32_t> counts,
+             ops::SamplingConfig cfg, std::vector<std::int32_t> overlay, bool graph_replay) {
+    const int vocab = static_cast<int>(logits.size());
+    GuardedDeviceBuffer x(logits.size() * 2), c(counts.size() * 4), cfg_dev(sizeof(cfg));
+    GuardedDeviceBuffer ov(std::max<std::size_t>(1, overlay.size()) * 4);
+    GuardedDeviceBuffer first(4), second(4);
+    x.copy_from_host(logits.data(), x.bytes());
+    c.copy_from_host(counts.data(), c.bytes());
+    cfg.token_counts = static_cast<std::int32_t*>(c.data());
+    cfg_dev.copy_from_host(&cfg, sizeof(cfg));
+    if (!overlay.empty()) ov.copy_from_host(overlay.data(), overlay.size() * 4);
+    Tensor logits_t(x.data(), DType::BF16, {vocab, 1});
+    Tensor first_t(first.data(), DType::I32, {1}), second_t(second.data(), DType::I32, {1});
+    const auto invoke = [&](cudaStream_t stream) {
+        ops::mtp_draft_argmax(logits_t, first_t, &second_t,
+            static_cast<const ops::SamplingConfig*>(cfg_dev.data()),
+            overlay.empty() ? nullptr : static_cast<const std::int32_t*>(ov.data()),
+            static_cast<std::int32_t>(overlay.size()), vocab, stream);
+    };
+    invoke(nullptr); cuda_synchronize();
+    int failures = 0;
+    const auto verify = [&] {
+        const auto exp = oracle(logits, counts, cfg, overlay);
+        failures += verify_exact("MTP penalty top1", from_device<std::int32_t>(first.data(), 1),
+                                 std::vector<std::int32_t>{exp.first});
+        failures += verify_exact("MTP penalty top2", from_device<std::int32_t>(second.data(), 1),
+                                 std::vector<std::int32_t>{exp.second});
+        failures += verify_exact("MTP draft leaves committed counts unchanged",
+                                 from_device<std::int32_t>(c.data(), counts.size()), counts);
+    };
+    verify();
+    if (graph_replay) {
+        cudaStream_t s{}; cudaGraph_t g{}; cudaGraphExec_t ge{};
+        CUDA_CHECK(cudaStreamCreateWithFlags(&s, cudaStreamNonBlocking));
+        CUDA_CHECK(cudaStreamBeginCapture(s, cudaStreamCaptureModeGlobal));
+        invoke(s);
+        CUDA_CHECK(cudaStreamEndCapture(s, &g));
+        CUDA_CHECK(cudaGraphInstantiate(&ge, g, nullptr, nullptr, 0));
+        for (int r = 0; r < 2; ++r) {
+            counts[r ? 4 : 1] = r ? 1 : 2;
+            overlay = r ? std::vector<std::int32_t>{4, 2} : std::vector<std::int32_t>{1, 3};
+            cfg.presence_penalty = r ? 0.75f : 2.0f;
+            cfg.frequency_penalty = r ? 0.5f : 0.25f;
+            c.copy_from_host(counts.data(), c.bytes());
+            ov.copy_from_host(overlay.data(), overlay.size() * 4);
+            cfg_dev.copy_from_host(&cfg, sizeof(cfg));
+            CUDA_CHECK(cudaGraphLaunch(ge, s)); CUDA_CHECK(cudaStreamSynchronize(s));
+            verify();
+        }
+        CUDA_CHECK(cudaGraphExecDestroy(ge)); CUDA_CHECK(cudaGraphDestroy(g)); CUDA_CHECK(cudaStreamDestroy(s));
+    }
+    return failures;
+}
+} // namespace
+
+int main() {
+    if (cuda_unavailable()) { std::cout << "SKIP: no usable CUDA device\n"; return 77; }
+    std::vector<std::uint16_t> logits;
+    for (float v : {1.f, 4.f, 3.f, 2.f, 5.f, 0.f, 4.f, -1.f}) logits.push_back(f32_to_bf16(v));
+    std::vector<std::int32_t> counts(8, 0); counts[4] = 1;
+    ops::SamplingConfig cfg; cfg.presence_penalty = 1.5f; cfg.frequency_penalty = 0.25f;
+    int failures = run_case(logits, counts, cfg, {4, 4}, true);
+    cfg.presence_penalty = cfg.frequency_penalty = 0.0f;
+    failures += run_case(logits, counts, cfg, {}, false);
+    std::cout << (failures ? "FAIL" : "OK") << " MTP draft penalty argmax\n";
+    return failures ? 1 : 0;
+}
