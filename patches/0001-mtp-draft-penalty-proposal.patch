diff --git a/src/ops/launcher/mtp_draft_argmax.cu b/src/ops/launcher/mtp_draft_argmax.cu
new file mode 100644
index 00000000..4a68ffae
--- /dev/null
+++ b/src/ops/launcher/mtp_draft_argmax.cu
@@ -0,0 +1,62 @@
+#include "ninfer/ops/mtp_draft_argmax.h"
+#include "ops/launcher/mtp_draft_argmax.h"
+#include "core/device.h"
+#include "ops/kernel/sampling_device.cuh"
+
+#include <climits>
+
+namespace ninfer::ops::detail {
+namespace {
+constexpr int kDraftBlock = kSamplerBlock;
+
+__device__ __forceinline__ void insert(float value, int id, float& a, int& ai, float& b, int& bi) {
+    if (sampling_better(value, id, a, ai)) { b = a; bi = ai; a = value; ai = id; }
+    else if (id != ai && sampling_better(value, id, b, bi)) { b = value; bi = id; }
+}
+
+__global__ void mtp_draft_argmax_kernel(const __nv_bfloat16* logits, int* first, int* second,
+                                        const SamplingConfig* configs, const int* overlay,
+                                        int overlay_len, int valid_rows, int physical_rows) {
+    const SamplingConfig cfg = configs[0];
+    float a = -CUDART_INF_F, b = -CUDART_INF_F;
+    int ai = INT_MAX, bi = INT_MAX;
+    for (int id = static_cast<int>(threadIdx.x); id < valid_rows; id += blockDim.x) {
+        const float raw = __bfloat162float(logits[id]);
+        const float score = sampling_adjusted_logit(raw, id, cfg, overlay, overlay_len);
+        insert(score, id, a, ai, b, bi);
+    }
+    __shared__ float av[kDraftBlock], bv[kDraftBlock];
+    __shared__ int aid[kDraftBlock], bid[kDraftBlock];
+    av[threadIdx.x] = a; aid[threadIdx.x] = ai;
+    bv[threadIdx.x] = b; bid[threadIdx.x] = bi;
+    __syncthreads();
+    for (int stride = blockDim.x / 2; stride > 0; stride >>= 1) {
+        if (threadIdx.x < stride) {
+            float na = av[threadIdx.x], nb = bv[threadIdx.x];
+            int nai = aid[threadIdx.x], nbi = bid[threadIdx.x];
+            insert(av[threadIdx.x + stride], aid[threadIdx.x + stride], na, nai, nb, nbi);
+            insert(bv[threadIdx.x + stride], bid[threadIdx.x + stride], na, nai, nb, nbi);
+            av[threadIdx.x] = na; aid[threadIdx.x] = nai;
+            bv[threadIdx.x] = nb; bid[threadIdx.x] = nbi;
+        }
+        __syncthreads();
+    }
+    if (threadIdx.x == 0) {
+        first[0] = aid[0];
+        if (second != nullptr) { second[0] = bid[0]; }
+    }
+    (void)physical_rows;
+}
+} // namespace
+
+void mtp_draft_argmax_launch(const Tensor& logits, Tensor& first, Tensor* second,
+                             const SamplingConfig* configs, const std::int32_t* overlay,
+                             std::int32_t overlay_len, std::int32_t valid_rows,
+                             cudaStream_t stream) {
+    mtp_draft_argmax_kernel<<<1, kDraftBlock, 0, stream>>>(
+        static_cast<const __nv_bfloat16*>(logits.data), static_cast<int*>(first.data),
+        second == nullptr ? nullptr : static_cast<int*>(second->data), configs, overlay,
+        overlay_len, valid_rows, static_cast<int>(logits.ne[0]));
+    CUDA_CHECK(cudaGetLastError());
+}
+} // namespace ninfer::ops::detail
