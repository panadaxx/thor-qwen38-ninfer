@@ -0,0 +1,32 @@
+#include "ninfer/ops/mtp_draft_argmax.h"
+#include "ops/launcher/mtp_draft_argmax.h"
+
+#include <stdexcept>
+
+namespace ninfer::ops {
+
+void mtp_draft_argmax(const Tensor& logits, Tensor& first, Tensor* second,
+                      const SamplingConfig* configs, const std::int32_t* overlay,
+                      std::int32_t overlay_len, std::int32_t valid_rows,
+                      cudaStream_t stream) {
+    if (logits.dtype != DType::BF16 || !logits.is_contiguous() || logits.ne[1] != 1 ||
+        logits.ne[2] != 1 || logits.ne[3] != 1 || valid_rows <= 0 ||
+        valid_rows > logits.ne[0] || logits.data == nullptr) {
+        throw std::invalid_argument("mtp_draft_argmax: expected contiguous BF16 [vocab,1]");
+    }
+    const auto valid_output = [](const Tensor& out) {
+        return out.dtype == DType::I32 && out.is_contiguous() && out.ne[0] == 1 &&
+               out.ne[1] == 1 && out.ne[2] == 1 && out.ne[3] == 1 && out.data != nullptr;
+    };
+    if (!valid_output(first) || (second != nullptr && !valid_output(*second)) ||
+        (second != nullptr && second->data == first.data)) {
+        throw std::invalid_argument("mtp_draft_argmax: outputs must be distinct I32 scalars");
+    }
+    if (configs == nullptr || overlay_len < 0 || (overlay_len > 0 && overlay == nullptr)) {
+        throw std::invalid_argument("mtp_draft_argmax: invalid device config or overlay");
+    }
+    detail::mtp_draft_argmax_launch(logits, first, second, configs, overlay, overlay_len,
+                                    valid_rows, stream);
+}
+
+} // namespace ninfer::ops
