+# Validate supported CUDA images before `project(... LANGUAGES CUDA)` so CMake does not inject a
+# host-default architecture or accept an image this source tree has not explicitly selected.
+function(ninfer_configure_cuda_architectures)
+  if(NOT DEFINED CMAKE_CUDA_ARCHITECTURES)
+    set(CMAKE_CUDA_ARCHITECTURES 86 CACHE STRING "CUDA architectures to build")
+  endif()
+
+  set(_ninfer_architectures ${CMAKE_CUDA_ARCHITECTURES})
+  list(REMOVE_DUPLICATES _ninfer_architectures)
+  list(LENGTH _ninfer_architectures _ninfer_architecture_count)
+  list(LENGTH CMAKE_CUDA_ARCHITECTURES _ninfer_listed_count)
+  if(_ninfer_architecture_count EQUAL 0 OR NOT _ninfer_architecture_count EQUAL _ninfer_listed_count)
+    message(FATAL_ERROR "CMAKE_CUDA_ARCHITECTURES must list each architecture once; got "
+      "'${CMAKE_CUDA_ARCHITECTURES}'")
+  endif()
+
+  foreach(_ninfer_architecture IN LISTS _ninfer_architectures)
+    if(NOT _ninfer_architecture MATCHES "^(70|75|80|86|89|110a|120a)$")
+      message(FATAL_ERROR
+        "NInfer supports CMAKE_CUDA_ARCHITECTURES of 70, 75, 80, 86, 89, 110a and 120a; "
+        "got '${_ninfer_architecture}'")
+    endif()
+  endforeach()
+
+  # First compatibility experiment for DRIVE Thor: build one explicit sm_110a image and route it
+  # through the conservative mma.sync implementation tier. Do not combine it with other images:
+  # the existing runtime probe maps PTX 10.x+ to the 120a Blackwell tier. This target does not
+  # enable any 120a-specific FP8, NVFP4, TMA, PDL or Tensor Memory route.
+  set(_ninfer_arch_sm110_compat OFF)
+  if("110a" IN_LIST _ninfer_architectures)
+    if(NOT _ninfer_architectures STREQUAL "110a")
+      message(FATAL_ERROR "110a is experimental and must be the only CMAKE_CUDA_ARCHITECTURES entry")
+    endif()
+    set(_ninfer_arch_sm110_compat ON)
+  endif()
+
+  set(NINFER_ARCH_VOLTA OFF)
+  set(NINFER_ARCH_TURING OFF)
+  set(NINFER_ARCH_AMPERE OFF)
+  set(NINFER_ARCH_BLACKWELL OFF)
+  if("70" IN_LIST _ninfer_architectures)
+    set(NINFER_ARCH_VOLTA ON)
+  endif()
+  if("75" IN_LIST _ninfer_architectures)
+    set(NINFER_ARCH_TURING ON)
+  endif()
+  if("80" IN_LIST _ninfer_architectures OR "86" IN_LIST _ninfer_architectures OR
+     "89" IN_LIST _ninfer_architectures)
+    set(NINFER_ARCH_AMPERE ON)
+  endif()
+  if("120a" IN_LIST _ninfer_architectures)
+    set(NINFER_ARCH_BLACKWELL ON)
+  endif()
+
+  set(NINFER_ARCH_VOLTA "${NINFER_ARCH_VOLTA}" PARENT_SCOPE)
+  set(NINFER_ARCH_TURING "${NINFER_ARCH_TURING}" PARENT_SCOPE)
+  set(NINFER_ARCH_AMPERE "${NINFER_ARCH_AMPERE}" PARENT_SCOPE)
+  set(NINFER_ARCH_BLACKWELL "${NINFER_ARCH_BLACKWELL}" PARENT_SCOPE)
+  set(NINFER_ARCH_SM110_COMPAT "${_ninfer_arch_sm110_compat}" PARENT_SCOPE)
+  set(_ninfer_architecture_count "${_ninfer_architecture_count}" PARENT_SCOPE)
+  set(_ninfer_architectures "${_ninfer_architectures}" PARENT_SCOPE)
+endfunction()
