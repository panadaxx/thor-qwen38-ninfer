+bool q6k_cublas_prefill_enabled() {
+#if defined(NINFER_SM110A_COMPAT)
+    static const bool enabled = [] {
+        const char* value = std::getenv("NINFER_GGUF_Q6K_CUBLAS_PREFILL");
+        return value != nullptr && std::strcmp(value, "1") == 0;
+    }();
+    return enabled;
+#else
+    return false;
+#endif
+}
+
+bool q6k_cublas_prefill_takes(gguf::GgmlType type, std::int32_t tokens) {
+    return q6k_cublas_prefill_enabled() && type == gguf::GgmlType::Q6_K &&
+           tokens > kDequantizedVectorColumns;
+}
+
+void log_q6k_cublas_prefill(std::int32_t rows, std::int32_t k, std::int32_t tokens) {
+    const char* value = std::getenv("NINFER_GGUF_Q6K_CUBLAS_PREFILL_LOG");
+    if (value == nullptr || std::strcmp(value, "1") != 0) { return; }
+    static std::atomic<std::uint64_t> calls{0};
+    const std::uint64_t call = calls.fetch_add(1, std::memory_order_relaxed) + 1;
+    std::fprintf(stderr,
+                 "[ninfer] q6k_dequant_cublas_prefill call=%llu rows=%d K=%d T=%d scratch_mib=16\n",
+                 static_cast<unsigned long long>(call), rows, k, tokens);
+}
 
