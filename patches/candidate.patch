+void iq2s_bf16_moe_product(const void* contiguous_weight, std::int64_t row_bytes, int experts,
+                           int rows, int k, const int* bounds_host, int pairs,
+                           const __nv_bfloat16* sorted_x, float* sorted_out,
+                           __nv_bfloat16* weight_scratch, cudaStream_t stream) {
+    const BlockShape block = block_shape(GgmlType::IQ2_S);
+    if (contiguous_weight == nullptr || bounds_host == nullptr || sorted_x == nullptr ||
+        sorted_out == nullptr || weight_scratch == nullptr || experts <= 0 || rows <= 0 ||
+        k <= 0 || k % block.elements != 0 || row_bytes != std::int64_t(k / block.elements) * block.bytes ||
+        pairs <= 0 || bounds_host[0] != 0 || bounds_host[experts] != pairs) {
+        throw std::invalid_argument("gguf IQ2_S BF16 MoE product: invalid inputs");
+    }
+    for (int e = 0; e < experts; ++e) {
+        if (bounds_host[e] < 0 || bounds_host[e] > bounds_host[e + 1] ||
+            bounds_host[e + 1] > pairs) {
+            throw std::invalid_argument("gguf IQ2_S BF16 MoE product: invalid route bounds");
+        }
+    }
+
+    // Reuse one expanded BF16 bank for Gate, then Up. The caller has already checked that
+    // `contiguous_weight` represents exactly these adjacent row-major expert banks.
+    dequantize_rows(GgmlType::IQ2_S, contiguous_weight, row_bytes, k, nullptr, experts * rows,
+                    weight_scratch, k, stream);
+    cublasHandle_t blas = detail::blas_handle();
+    if (cublasSetStream(blas, stream) != CUBLAS_STATUS_SUCCESS) {
+        throw std::runtime_error("gguf IQ2_S BF16 MoE product: cublasSetStream failed");
+    }
+    const float alpha = 1.0f, beta = 0.0f;
+    for (int e = 0; e < experts; ++e) {
+        const int first = bounds_host[e];
+        const int m     = bounds_host[e + 1] - first;
+        if (m == 0) { continue; }
+        const auto* w = weight_scratch + std::int64_t(e) * rows * k;
+        const auto* x = sorted_x + std::int64_t(first) * k;
+        auto* y       = sorted_out + std::int64_t(first) * rows;
+        const cublasStatus_t status = cublasGemmEx(
+            blas, CUBLAS_OP_T, CUBLAS_OP_N, rows, m, k, &alpha, w, CUDA_R_16BF, k,
+            x, CUDA_R_16BF, k, &beta, y, CUDA_R_32F, rows, CUBLAS_COMPUTE_32F,
+            CUBLAS_GEMM_DEFAULT_TENSOR_OP);
+        if (status != CUBLAS_STATUS_SUCCESS) {
+            throw std::runtime_error("gguf IQ2_S BF16 MoE product: cublasGemmEx failed");
+        }
+    }
+}
