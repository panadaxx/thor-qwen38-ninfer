+__global__ void iq2s_bf16_dequantize_table_kernel(const void* const* __restrict__ weight_table,
+                                                  int experts, int rows_per_expert,
+                                                  std::int64_t row_bytes, int k,
+                                                  __nv_bfloat16* __restrict__ out,
+                                                  std::int64_t out_row_stride) {
+    using D = detail::vec::Decoder<GGML_TYPE_IQ2_S>;
+    constexpr int kTable = D::kTableWords;
+    constexpr int kPerBlock = D::kBlockElems / 32;
+    __shared__ __align__(16) std::uint32_t table[kTable];
+    const std::uint32_t* source_table = D::table();
+    for (int i = threadIdx.x; i < kTable; i += blockDim.x) { table[i] = source_table[i]; }
+    __syncthreads();
+
+    const int slices = k / 32;
+    const std::int64_t rows = std::int64_t(experts) * rows_per_expert;
+    const std::int64_t total = rows * slices;
+    for (std::int64_t i = std::int64_t(blockIdx.x) * blockDim.x + threadIdx.x; i < total;
+         i += std::int64_t(gridDim.x) * blockDim.x) {
+        const std::int64_t global_row = i / slices;
+        const int slice = static_cast<int>(i % slices);
+        const int expert = static_cast<int>(global_row / rows_per_expert);
+        const int local_row = static_cast<int>(global_row % rows_per_expert);
+        const auto* expert_base = static_cast<const std::uint8_t*>(weight_table[expert]);
+        const auto* block = expert_base + std::int64_t(local_row) * row_bytes +
+                            std::int64_t(slice / kPerBlock) * D::kBlockBytes;
+        detail::vec::Slice decoded;
+        D::decode(block, slice % kPerBlock, table, decoded);
+        __nv_bfloat16* dst = out + global_row * out_row_stride + 32 * std::int64_t(slice);
+#pragma unroll
+        for (int q = 0; q < 4; ++q) {
+            float values[8];
+#pragma unroll
+            for (int t = 0; t < 8; ++t) {
+                values[t] = detail::vec::slice_value<GGML_TYPE_IQ2_S>(decoded, 2 * q + t / 4,
+                                                                      t % 4);
+            }
+            detail::vec::store8(dst + 8 * q, values);
+        }
+    }
+}
+
+} // namespace
+
+void iq2s_bf16_dequantize_table(const void* const* weight_table, int experts, int rows_per_expert,
+                               std::int64_t row_bytes, int k, __nv_bfloat16* out,
+                               std::int64_t out_row_stride, cudaStream_t stream) {
+    using D = detail::vec::Decoder<GGML_TYPE_IQ2_S>;
+    const std::int64_t exact_row_bytes = std::int64_t(k / D::kBlockElems) * D::kBlockBytes;
+    if (weight_table == nullptr || experts <= 0 || rows_per_expert <= 0 || out == nullptr ||
+        k <= 0 || k % D::kBlockElems != 0 || row_bytes != exact_row_bytes ||
+        out_row_stride < k || out_row_stride % 8 != 0 ||
+        reinterpret_cast<std::uintptr_t>(out) % 16 != 0) {
+        throw std::invalid_argument("gguf IQ2_S table dequantize: unsupported geometry");
+    }
+    const std::int64_t total = std::int64_t(experts) * rows_per_expert * (k / 32);
+    static const int resident = [] {
+        int blocks = 0;
+        detail::check(cudaOccupancyMaxActiveBlocksPerMultiprocessor(
+                          &blocks, iq2s_bf16_dequantize_table_kernel, 256, 0),
+                      "IQ2_S table BF16 dequantize occupancy");
+        return std::max(blocks, 1);
+    }();
+    const int blocks = static_cast<int>(std::min<std::int64_t>(
+        (total + 255) / 256, std::int64_t(resident) * detail::device_facts().sm_count));
+    iq2s_bf16_dequantize_table_kernel<<<blocks, 256, 0, stream>>>(
+        weight_table, experts, rows_per_expert, row_bytes, k, out, out_row_stride);
+    detail::check(cudaGetLastError(), "IQ2_S table BF16 dequantize launch");
+}
