+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#include "core/device.h"
+#include "models/qwen3_5/weights.h"
+
+#include <filesystem>
+#include <memory>
+#include <vector>
+
+namespace ninfer::models::qwen4_exp {
+
+// Opt-in, model-owned Q8_0 replacements for the 290 text hyper-connection matrices.
+// The sidecar directory is produced by p4-hc-q8/hc_q8_sidecar.py.
+class HcQ8Sidecar {
+public:
+    HcQ8Sidecar(const std::filesystem::path& directory, std::vector<qwen3_5::BoundWeight>& bound,
+                DeviceContext& device);
+    ~HcQ8Sidecar();
+
+    HcQ8Sidecar(const HcQ8Sidecar&)            = delete;
+    HcQ8Sidecar& operator=(const HcQ8Sidecar&) = delete;
+    HcQ8Sidecar(HcQ8Sidecar&&) noexcept;
+    HcQ8Sidecar& operator=(HcQ8Sidecar&&) noexcept;
+
+private:
+    struct Entry;
+    // Heap entries keep WeightParent addresses stable for the lifetime of BoundWeight views.
+    std::vector<std::unique_ptr<Entry>> entries_;
+};
+
+} // namespace ninfer::models::qwen4_exp
