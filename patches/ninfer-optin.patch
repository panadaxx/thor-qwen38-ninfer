+struct EdgeDenseSidecar::Entry {
+    std::string id;
+    // Destruction is reverse declaration order: unregister kernels before releasing their planes.
+    DeviceBuffer codes;
+    DeviceBuffer scales;
+    DeviceBuffer global;
+    std::shared_ptr<ops::edge_dense::Registration> registration;
+};
+
+EdgeDenseSidecar::EdgeDenseSidecar(const std::filesystem::path& directory,
+                                   const artifact::Reader& reader,
+                                   std::vector<BoundWeight>& bound, DeviceContext& device) {
+    const auto manifest_path = directory / "manifest.json";
+    std::ifstream manifest_file(manifest_path, std::ios::binary);
+    if (!manifest_file) {
+        throw std::runtime_error("cannot open EdgeDense manifest: " + manifest_path.string());
+    }
+    Json manifest;
+    try { manifest_file >> manifest; }
+    catch (const std::exception& error) {
+        throw std::runtime_error("invalid EdgeDense manifest: " + std::string(error.what()));
+    }
+    if (!manifest.is_object() || manifest.value("version", 0) != 1 ||
+        required_string(manifest, "artifact_id") != artifact_hex(reader.artifact_id()) ||
+        !manifest.contains("objects") || !manifest.at("objects").is_array()) {
+        throw std::invalid_argument("EdgeDense manifest does not match the loaded artifact");
+    }
+    const std::string cubin_name = required_string(manifest, "cubin");
+    if (cubin_name != kCubinName) {
+        throw std::invalid_argument("EdgeDense cubin must be " + std::string(kCubinName));
+    }
+    const auto cubin_path = directory / cubin_name;
+    if (!std::filesystem::is_regular_file(cubin_path)) {
+        throw std::invalid_argument("EdgeDense cubin is missing: " + cubin_path.string());
+    }
+    const std::string cubin_hash = required_string(manifest, "cubin_sha256");
+    if (cubin_hash.size() != 64 ||
+        !std::all_of(cubin_hash.begin(), cubin_hash.end(), [](unsigned char c) {
+            return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+        })) {
+        throw std::invalid_argument("EdgeDense cubin_sha256 must be lowercase SHA-256 hex");
+    }
+    const auto cubin_bytes = std::filesystem::file_size(cubin_path);
+    if (cubin_bytes == 0 || cubin_bytes > 2 * 1024 * 1024) {
+        throw std::invalid_argument("EdgeDense cubin has an unexpected size");
+    }
+    std::vector<std::uint8_t> cubin_host(static_cast<std::size_t>(cubin_bytes));
+    {
+        std::ifstream cubin_file(cubin_path, std::ios::binary);
+        cubin_file.read(reinterpret_cast<char*>(cubin_host.data()),
+                        static_cast<std::streamsize>(cubin_host.size()));
+        if (cubin_file.gcount() != static_cast<std::streamsize>(cubin_host.size()) ||
+            sha256_hex(cubin_host) != cubin_hash) {
+            throw std::invalid_argument("EdgeDense cubin is truncated or has SHA-256 mismatch");
+        }
+    }
+    if (required_string(manifest, "target_layout") != kTargetLayout) {
+        throw std::invalid_argument("EdgeDense manifest target_layout is not the frozen TRT-Edge format");
+    }
+
+    // Resolve exact q/k/v logical slices back to their common encoded Q6 parent. We never infer
+    // identity from tensor names alone: all three source object IDs and WeightRegion parents must
+    // agree, and their explicit element intervals must tile the whole parent exactly.
+    std::map<std::string, ParentBinding, std::less<>> parents;
+    for (auto& weight : bound) {
+        std::uint32_t layer = 0;
+        std::string role;
+        if (!parse_gdn_qkv_name(weight.name, layer, role)) { continue; }
+        (void)layer;
+        if (weight.view.parts.empty()) { continue; }
+        const bool has_q6_parent = std::any_of(
+            weight.view.parts.begin(), weight.view.parts.end(), [](const auto& candidate) {
+                return candidate.parent && candidate.parent->geometry.format == QType::GGUF_Q6_K;
+            });
+        if (!has_q6_parent) { continue; }
+        if (weight.rank != 0 || weight.source_objects.size() != 1 || weight.view.parts.size() != 1) {
+            throw std::invalid_argument(weight.name + ": EdgeDense requires one rank-0 whole-parent slice");
+        }
+        auto& part = weight.view.parts.front();
+        if (!part.parent || weight.view.shape != expected_view_shape(role) ||
+            part.parent->geometry.format != QType::GGUF_Q6_K ||
+            part.parent->geometry.layout != QuantLayout::GgufBlocks ||
+            part.parent->geometry.shape.size() != 2 ||
+            part.parent->geometry.shape[1] != kCols ||
+            (part.parent->geometry.shape[0] != kRows && part.parent->geometry.shape[0] != 16384) ||
+            part.parent->geometry.elements != part.parent->geometry.shape[0] * kCols ||
+            part.parent->geometry.bytes != part.parent->geometry.shape[0] * kQ6BytesPerRow ||
+            part.begin >= part.end || part.end > kElements) {
+            throw std::invalid_argument(weight.name + ": source is not an expected Q6_K GDN parent/prefix");
+        }
+        const auto [want_begin, want_end] = expected_range(role);
+        if (part.begin != want_begin || part.end != want_end) {
+            throw std::invalid_argument(weight.name + ": source view has unexpected QKV row order/range");
+        }
+        auto& group = parents[weight.source_objects.front()];
+        if (group.parent && group.parent != part.parent) {
+            throw std::invalid_argument(weight.name + ": object id resolves to multiple parent buffers");
+        }
+        group.parent = part.parent;
+        if (!group.views.emplace(role, ViewBinding{&weight, part.begin, part.end, part.parent}).second) {
+            throw std::invalid_argument(weight.name + ": duplicate GDN QKV source view");
+        }
+    }
+    if (parents.size() != kExpectedParents) {
+        throw std::invalid_argument("EdgeDense expects 22 Q6_K GDN QKV parents, found " +
+                                    std::to_string(parents.size()));
+    }
+    for (const auto& [id, group] : parents) {
+        if (group.views.size() != 3 || !group.views.contains("query") ||
+            !group.views.contains("key") || !group.views.contains("value")) {
+            throw std::invalid_argument("EdgeDense parent " + id + ": q/k/v do not cover all views");
+        }
+        const auto& q = group.views.at("query");
+        const auto& k = group.views.at("key");
+        const auto& v = group.views.at("value");
+        if (q.begin != 0 || q.end != k.begin || k.end != v.begin || v.end != kElements ||
+            q.parent != k.parent || q.parent != v.parent || v.end != kElements) {
+            throw std::invalid_argument("EdgeDense parent " + id + ": q/k/v slices do not exactly cover the QKV prefix");
+        }
+    }
+
+    const auto& objects = manifest.at("objects");
+    if (objects.empty() || objects.size() > parents.size()) {
+        throw std::invalid_argument("EdgeDense manifest must select between 1 and 22 Q6 parents");
+    }
+    const std::uint64_t planned_bytes = objects.size() * kNvfp4Bytes;
+    constexpr std::uint64_t kRequiredFreeReserve = 4ULL * 1024 * 1024 * 1024;
+    {
+        DeviceBinding binding(device.rank(0).device);
+        if (device.free_bytes() < planned_bytes + kRequiredFreeReserve) {
+            throw std::runtime_error("EdgeDense sidecar refused: GPU free memory is below selected "
+                                    "payload plus 4 GiB reserve");
+        }
+    }
+    std::set<std::string> seen;
+    std::uint64_t total_bytes = 0;
+    entries_.reserve(parents.size());
+    for (const auto& item : objects) {
+        if (!item.is_object()) { throw std::invalid_argument("EdgeDense object entry must be an object"); }
+        const std::string id = required_string(item, "id");
+        const auto found = parents.find(id);
+        if (found == parents.end() || !seen.insert(id).second) {
+            throw std::invalid_argument("EdgeDense object id is unknown or duplicated: " + id);
+        }
+        if (!item.contains("shape") || item.at("shape") != Json::array({kRows, kCols})) {
+            throw std::invalid_argument("EdgeDense object " + id + ": expected shape [10240,2560]");
+        }
+        const auto& source_shape = item.at("source_shape");
+        const auto source_handle = reader.find(id);
+        const auto& source_object = reader.directory().tensor(source_handle);
+        const auto source_offset = checked_u64(item.at("source_offset"), "source_offset");
+        if (!source_shape.is_array() || source_shape.size() != 2 ||
+            checked_u64(source_shape[0], "source_shape[0]") != found->second.parent->geometry.shape[0] ||
+            checked_u64(source_shape[1], "source_shape[1]") != kCols ||
+            required_string(item, "source_format") != "gguf_q6_k" ||
+            required_string(item, "source_layout") != "gguf_blocks_v1" ||
+            checked_u64(item.at("source_parent_bytes"), "source_parent_bytes") != found->second.parent->geometry.bytes ||
+            source_object.shape != found->second.parent->geometry.shape ||
+            source_object.format != "gguf_q6_k" || source_object.layout != "gguf_blocks_v1" ||
+            source_object.bytes != found->second.parent->geometry.bytes ||
+            source_object.offset != source_offset ||
+            checked_u64(item.at("source_bytes"), "source_bytes") != kQ6Bytes ||
+            !item.contains("source_range") || !item.at("source_range").is_array() ||
+            item.at("source_range").size() != 2 ||
+            checked_u64(item.at("source_range")[0], "source_range begin") != 0 ||
+            checked_u64(item.at("source_range")[1], "source_range end") != kElements) {
+            throw std::invalid_argument("EdgeDense object " + id + ": source format/layout/extent mismatch");
+        }
+        const std::string source_hash = required_string(item, "source_sha256");
+        const auto valid_hash = [](std::string_view hash) {
+            return hash.size() == 64 && std::all_of(hash.begin(), hash.end(), [](unsigned char c) {
+                return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+            });
+        };
+        if (!valid_hash(source_hash)) {
+            throw std::invalid_argument("EdgeDense object " + id + ": source_sha256 must be lowercase hex");
+        }
+        // Header ID is not a content digest: verify the exact original Q6 prefix too.
+        {
+            auto original = reader.read_range(source_offset, kQ6Bytes);
+            auto raw = std::span<const std::uint8_t>(
+                reinterpret_cast<const std::uint8_t*>(original.data()), original.size());
+            if (sha256_hex(raw) != source_hash) {
+                throw std::invalid_argument("EdgeDense source Q6 prefix SHA-256 mismatch: " + id);
+            }
+        }
+        if (!item.contains("runtime_bindings") || !item.at("runtime_bindings").is_array() ||
+            item.at("runtime_bindings").size() != 3) {
+            throw std::invalid_argument("EdgeDense object " + id + ": runtime_bindings must list query/key/value");
+        }
+        std::set<std::string> manifest_roles;
+        for (const auto& runtime_binding : item.at("runtime_bindings")) {
+            const auto name = required_string(runtime_binding, "name");
+            const auto found_binding = found->second.views.find(name.substr(name.rfind('/') + 1));
+            if (found_binding == found->second.views.end() || name != found_binding->second.weight->name ||
+                !runtime_binding.contains("range") || !runtime_binding.at("range").is_array() ||
+                runtime_binding.at("range").size() != 2 ||
+                checked_u64(runtime_binding.at("range")[0], "runtime binding range begin") != found_binding->second.begin ||
+                checked_u64(runtime_binding.at("range")[1], "runtime binding range end") != found_binding->second.end ||
+                !manifest_roles.insert(found_binding->first).second) {
+                throw std::invalid_argument("EdgeDense object " + id + ": runtime binding differs from artifact view");
+            }
+        }
+        if (manifest_roles.size() != 3) {
+            throw std::invalid_argument("EdgeDense object " + id + ": runtime binding set is incomplete");
+        }
+        const auto bytes = checked_u64(item.at("bytes"), "object bytes");
+        if (bytes != kNvfp4Bytes || total_bytes > kMaxTotalSidecarBytes - bytes) {
+            throw std::invalid_argument("EdgeDense object " + id + ": invalid payload extent/budget");
+        }
+        const std::string payload_name = required_string(item, "payload");
+        if (std::filesystem::path(payload_name).filename() != payload_name || payload_name.empty()) {
+            throw std::invalid_argument("EdgeDense payload must be a filename within its sidecar directory");
+        }
+        const std::string expected_hash = required_string(item, "sha256");
+        if (!valid_hash(expected_hash)) {
+            throw std::invalid_argument("EdgeDense object " + id + ": sha256 must be lowercase hex");
+        }
+        const auto payload_path = directory / payload_name;
+        std::ifstream payload(payload_path, std::ios::binary);
+        if (!payload) { throw std::runtime_error("cannot open EdgeDense payload " + payload_path.string()); }
+        payload.seekg(0, std::ios::end);
+        const auto end = payload.tellg();
+        if (end < 0 || static_cast<std::uint64_t>(end) != bytes) {
+            throw std::invalid_argument("EdgeDense payload byte length differs from manifest: " + id);
+        }
+        std::vector<std::uint8_t> host(static_cast<std::size_t>(bytes));
+        payload.seekg(0, std::ios::beg);
+        payload.read(reinterpret_cast<char*>(host.data()), static_cast<std::streamsize>(bytes));
+        if (payload.gcount() != static_cast<std::streamsize>(bytes) || sha256_hex(host) != expected_hash) {
+            throw std::invalid_argument("EdgeDense payload is truncated or has SHA-256 mismatch: " + id);
+        }
+        auto entry = std::make_unique<Entry>();
+        entry->id = id;
+        const auto* codes = host.data();
+        const auto* scales = codes + kCodesBytes;
+        const auto* global = scales + kScalesBytes;
+        float divisor = 0.0F;
+        std::memcpy(&divisor, global, sizeof(divisor));
+        if (!std::isfinite(divisor) || divisor <= 0.0F) {
+            throw std::invalid_argument("EdgeDense object " + id + ": FP32 global factor must be finite and positive");
+        }
+        {
+            DeviceBinding binding(device.rank(0).device);
+            entry->codes = DeviceBuffer(static_cast<std::size_t>(kCodesBytes));
+            entry->scales = DeviceBuffer(static_cast<std::size_t>(kScalesBytes));
+            entry->global = DeviceBuffer(static_cast<std::size_t>(kGlobalBytes));
+            entry->codes.copy_from_host(codes, static_cast<std::size_t>(kCodesBytes));
+            entry->scales.copy_from_host(scales, static_cast<std::size_t>(kScalesBytes));
+            entry->global.copy_from_host(global, static_cast<std::size_t>(kGlobalBytes));
+            entry->registration = ops::edge_dense::register_plane(
+                found->second.parent->data, entry->codes.p, entry->scales.p, entry->global.p, cubin_path);
+        }
+        if (!entry->registration) {
+            throw std::runtime_error("EdgeDense backend refused registration for parent " + id);
+        }
+        entries_.push_back(std::move(entry));
+        total_bytes += bytes;
+    }
+    if (seen.size() != objects.size() || total_bytes != objects.size() * kNvfp4Bytes) {
+        throw std::invalid_argument("EdgeDense manifest is incomplete or has an unexpected total extent");
+    }
+}
+
+EdgeDenseSidecar::~EdgeDenseSidecar() = default;
+EdgeDenseSidecar::EdgeDenseSidecar(EdgeDenseSidecar&&) noexcept = default;
+EdgeDenseSidecar& EdgeDenseSidecar::operator=(EdgeDenseSidecar&&) noexcept = default;
+
+std::size_t EdgeDenseSidecar::parent_count() const noexcept { return entries_.size(); }
+
+} // namespace ninfer::models::qwen4_exp
