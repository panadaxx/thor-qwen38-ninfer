+constexpr std::uint64_t kRows = 10240;
+constexpr std::uint64_t kCols = 2560;
+constexpr std::uint64_t kElements = kRows * kCols;
+constexpr std::uint64_t kQ6Bytes = kRows * (kCols / 256) * 210;
+constexpr std::uint64_t kQ6BytesPerRow = (kCols / 256) * 210;
+constexpr std::uint64_t kCodesBytes = kElements / 2;
+constexpr std::uint64_t kScalesBytes = kElements / 16;
+constexpr std::uint64_t kGlobalBytes = sizeof(float);
+constexpr std::uint64_t kNvfp4Bytes = kCodesBytes + kScalesBytes + kGlobalBytes;
+constexpr std::size_t kExpectedParents = 22;
+constexpr std::uint64_t kMaxTotalSidecarBytes = kExpectedParents * kNvfp4Bytes;
+constexpr std::string_view kTargetLayout = "edgellm_nvfp4_a16_n128_k64_v1";
+constexpr std::string_view kCubinName = "gemv-10240-2560.cubin";
+
+std::string artifact_hex(const artifact::ArtifactId& id) {
+    constexpr char digits[] = "0123456789abcdef";
+    std::string result;
+    result.reserve(id.size() * 2);
+    for (const auto byte : id) {
+        const auto value = std::to_integer<unsigned>(byte);
+        result.push_back(digits[value >> 4]);
+        result.push_back(digits[value & 15]);
+    }
+    return result;
+}
+
+std::string sha256_hex(std::span<const std::uint8_t> bytes) {
+    return qwen3_5::frontend::sha256_hex(qwen3_5::frontend::sha256(bytes));
+}
+
+struct ViewBinding {
+    BoundWeight* weight = nullptr;
+    std::uint64_t begin = 0;
+    std::uint64_t end = 0;
+    const WeightParent* parent = nullptr;
+};
+struct ParentBinding {
+    const WeightParent* parent = nullptr;
+    std::map<std::string, ViewBinding, std::less<>> views;
+};
+
+bool parse_gdn_qkv_name(std::string_view name, std::uint32_t& layer, std::string& role) {
+    constexpr std::string_view prefix = "text/layers/";
+    if (!name.starts_with(prefix)) { return false; }
+    const auto slash = name.find('/', prefix.size());
+    if (slash == std::string_view::npos ||
+        name.substr(slash) != "/gdn/query" && name.substr(slash) != "/gdn/key" &&
+        name.substr(slash) != "/gdn/value") { return false; }
+    const auto [end, error] = std::from_chars(name.data() + prefix.size(), name.data() + slash, layer);
+    if (error != std::errc{} || end != name.data() + slash) { return false; }
+    role.assign(name.substr(slash + std::string_view("/gdn/").size()));
+    return true;
+}
+
+std::pair<std::uint64_t, std::uint64_t> expected_range(std::string_view role) {
+    if (role == "query") { return {0, 2048ULL * kCols}; }
+    if (role == "key") { return {2048ULL * kCols, 4096ULL * kCols}; }
+    if (role == "value") { return {4096ULL * kCols, kElements}; }
+    throw std::invalid_argument("EdgeDense: unsupported GDN QKV role");
+}
+
+artifact::Shape expected_view_shape(std::string_view role) {
+    if (role == "query") { return {2048, kCols}; }
+    if (role == "key") { return {2048, kCols}; }
+    if (role == "value") { return {6144, kCols}; }
+    throw std::invalid_argument("EdgeDense: unsupported GDN QKV role");
+}
+
+std::uint64_t checked_u64(const Json& value, std::string_view label) {
+    if (!value.is_number_unsigned()) {
+        throw std::invalid_argument("EdgeDense: " + std::string(label) + " must be uint64");
+    }
+    return value.get<std::uint64_t>();
+}
+
+std::string required_string(const Json& object, std::string_view key) {
+    if (!object.contains(key) || !object.at(key).is_string()) {
+        throw std::invalid_argument("EdgeDense: manifest field '" + std::string(key) +
+                                    "' must be a string");
+    }
+    return object.at(key).get<std::string>();
+}
+
+} // namespace
