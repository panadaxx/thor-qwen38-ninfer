+// SPDX-License-Identifier: Apache-2.0
+// Minimal NInfer ABI shim around unmodified NVIDIA TensorRT-Edge-LLM kernels.
+#include "edge_dense.h"
+#include <atomic>
+#include <cstdio>
+#include <fstream>
+#include <map>
+#include <mutex>
+#include <stdexcept>
+#include <vector>
+#if defined(NINFER_EDGE_DENSE_AOT)
+#include "nvfp4_a16_blackwell_gemm_bf16_tm128_tn8_tk64.h"
+#include <cuda.h>
+namespace ninfer::ops::edge_dense {
+namespace {
+void check(cudaError_t e, const char *where) {
+  if (e != cudaSuccess)
+    throw std::runtime_error(std::string(where) + ": " + cudaGetErrorString(e));
+}
+void driver(CUresult e, const char *where) {
+  if (e != CUDA_SUCCESS) {
+    const char *s = nullptr;
+    cuGetErrorString(e, &s);
+    throw std::runtime_error(std::string(where) + ": " + (s ? s : "DriverAPI"));
+  }
+}
+struct Backend {
+  CUmodule gemv{};
+  CUfunction fn{};
+  nvfp4_a16_blackwell_gemm_bf16_tm128_tn8_tk64_Kernel_Module_t tc{};
+  std::filesystem::path path;
+  CUcontext context{};
+  explicit Backend(const std::filesystem::path &p) : path(p) {
+    cudaDeviceProp prop{};
+    int device = -1;
+    check(cudaGetDevice(&device), "Edge device");
+    check(cudaGetDeviceProperties(&prop, device), "Edge props");
+    if (device != 0 || prop.major != 11 || prop.minor != 0 ||
+        prop.multiProcessorCount != 14)
+      throw std::runtime_error(
+          "Edge Dense prototype requires rank0 LS9 SM110/14");
+    driver(cuCtxGetCurrent(&context), "Edge context");
+    if (!context)
+      throw std::runtime_error("Edge runtime primary context missing");
+    auto bytes = std::filesystem::file_size(path);
+    if (bytes < 64 || bytes > 2 * 1024 * 1024)
+      throw std::runtime_error("Edge Dense CUBIN size");
+    std::ifstream f(path, std::ios::binary);
+    std::vector<char> b(static_cast<size_t>(bytes));
+    f.read(b.data(), b.size());
+    if (size_t(f.gcount()) != b.size() || b[0] != char(0x7f) || b[1] != 'E' ||
+        b[2] != 'L' || b[3] != 'F')
+      throw std::runtime_error("Edge Dense invalid CUBIN");
+    try {
+      driver(cuModuleLoadData(&gemv, b.data()), "Edge GEMV load");
+      driver(cuModuleGetFunction(&fn, gemv, "nvfp4_a16_blackwell_gemv_m1_sk1"),
+             "Edge GEMV symbol");
+      nvfp4_a16_blackwell_gemm_bf16_tm128_tn8_tk64_Kernel_Module_Load(&tc);
+      check(cudaGetLastError(), "Edge TC load");
+      if (!tc.module)
+        throw std::runtime_error("Edge TC module missing");
+    } catch (...) {
+      if (tc.module)
+        cudaLibraryUnload(tc.module);
+      if (gemv)
+        cuModuleUnload(gemv);
+      throw;
+    }
+  }
+  ~Backend() {
+    if (tc.module)
+      cudaLibraryUnload(tc.module);
+    if (gemv)
+      cuModuleUnload(gemv);
+  }
+};
+std::mutex registry_mutex;
+std::map<const void *, std::weak_ptr<Registration>> registry;
+std::weak_ptr<Backend> backend_cache;
+std::atomic<bool> has_planes{false};
+} // namespace
+class Registration {
+public:
+  const void *original;
+  const void *codes;
+  const void *scales;
+  const void *global;
+  std::shared_ptr<Backend> backend;
+  bool registered = false;
+  Registration(const void *o, const void *c, const void *s, const void *g,
+               std::shared_ptr<Backend> b)
+      : original(o), codes(c), scales(s), global(g), backend(std::move(b)) {}
+  ~Registration() {
+    if (!registered)
+      return;
+    std::lock_guard<std::mutex> lock(registry_mutex);
+    auto f = registry.find(original);
+    if (f != registry.end() && f->second.expired())
+      registry.erase(f);
+    has_planes.store(!registry.empty(), std::memory_order_release);
+  }
+};
+std::shared_ptr<Registration>
+register_plane(const void *original, const void *codes, const void *scales,
+               const void *global, const std::filesystem::path &cubin) {
+  if (!original || !codes || !scales || !global ||
+      reinterpret_cast<uintptr_t>(codes) % 16 ||
+      reinterpret_cast<uintptr_t>(scales) % 16 ||
+      reinterpret_cast<uintptr_t>(global) % 4)
+    throw std::runtime_error("Edge Dense null/unaligned registration");
+  std::lock_guard<std::mutex> lock(registry_mutex);
+  if (auto f = registry.find(original);
+      f != registry.end() && !f->second.expired())
+    throw std::runtime_error("Edge Dense duplicate parent registration");
+  auto b = backend_cache.lock();
+  if (b && b->path != cubin)
+    throw std::runtime_error("Edge Dense incompatible backend while active");
+  if (!b) {
+    b = std::make_shared<Backend>(cubin);
+    backend_cache = b;
+  }
+  auto r = std::make_shared<Registration>(original, codes, scales, global,
+                                          std::move(b));
+  registry[original] = r;
+  r->registered = true;
+  has_planes.store(true, std::memory_order_release);
+  return r;
+}
+bool try_linear(const Tensor &x, const Weight &w, Tensor &out,
+                cudaStream_t stream) {
+  if (!has_planes.load(std::memory_order_acquire) ||
+      w.qtype != QType::GGUF_Q6_K || w.layout != QuantLayout::GgufBlocks ||
+      w.n != 10240 || w.k != 2560 || w.qdata != w.payload || w.input_columns)
+    return false;
+  std::shared_ptr<Registration> r;
+  {
+    std::lock_guard<std::mutex> lock(registry_mutex);
+    auto f = registry.find(w.payload);
+    if (f == registry.end() || !(r = f->second.lock()))
+      return false;
+  }
+  if (x.dtype != DType::BF16 || out.dtype != DType::BF16 ||
+      !x.is_contiguous() || !out.is_contiguous() || x.ne[0] != 2560 ||
+      out.ne[0] != 10240 || out.ne[1] != x.ne[1] || x.ne[1] < 1 ||
+      x.ne[1] > 8192)
+    throw std::runtime_error(
+        "Edge Dense registered family received unsupported tensor geometry");
+  const int t = x.ne[1];
+  if (t == 1) {
+    void *a = x.data, *c = const_cast<void *>(r->codes),
+         *s = const_cast<void *>(r->scales), *g = const_cast<void *>(r->global),
+         *o = out.data, *partial = nullptr;
+    void *args[] = {&a, &c, &s, &g, &o, &partial};
+    driver(cuLaunchKernel(r->backend->fn, 80, 1, 1, 256, 1, 1, 0,
+                          reinterpret_cast<CUstream>(stream), args, nullptr),
+           "Edge GEMV launch");
+    static std::atomic<bool> logged{false};
+    if (!logged.exchange(true))
+      std::fprintf(stderr, "EDGE_NVFP4_DENSE dispatch T1 N10240 K2560 official "
+                           "GEMV sk1; Q6 backing retained\n");
+  } else {
+    int result = cute_dsl_nvfp4_a16_blackwell_gemm_bf16_tm128_tn8_tk64_wrapper(
+        &r->backend->tc, x.data, const_cast<void *>(r->codes),
+        const_cast<void *>(r->scales), const_cast<void *>(r->global), out.data,
+        t, 10240, 2560, 14, stream);
+    if (result)
+      throw std::runtime_error("Edge Dense TC wrapper failed");
+    static std::atomic<bool> logged{false};
+    if (!logged.exchange(true))
+      std::fprintf(stderr,
+                   "EDGE_NVFP4_DENSE dispatch T%d N10240 K2560 official TC; "
+                   "quality scoring uses sidecar\n",
+                   t);
+  }
+  check(cudaGetLastError(), "Edge Dense launch");
+  return true;
+}
+} // namespace ninfer::ops::edge_dense
+#else
+namespace ninfer::ops::edge_dense {
+class Registration {};
+std::shared_ptr<Registration> register_plane(const void *, const void *,
+                                             const void *, const void *,
+                                             const std::filesystem::path &) {
+  throw std::runtime_error("Edge Dense AOT support not compiled");
+}
+bool try_linear(const Tensor &, const Weight &, Tensor &, cudaStream_t) {
+  return false;
+}
+} // namespace ninfer::ops::edge_dense
+#endif
