+// Adapted from NInfer upstream ggml_bridge_vec.cuh at e644a7d (Apache-2.0, see SOURCE.md).
+// The only arithmetic-schedule change is static K unrolling; K=2560's third chunk is guarded
+// per lane, preserving the production runtime loop's slice order and FP32 accumulation order.
+#include "q6k_cooperative.h"
+#include "ggml_bridge_vec.cuh"
+#include "ggml_bridge_coop_q6.cuh"
+
+#include <algorithm>
+#include <stdexcept>
+#include <string>
+
+namespace ninfer::q6k_cooperative {
+namespace {
+
+namespace gguf = ninfer::ops::gguf;
+namespace detail = ninfer::ops::gguf::detail;
+namespace vec = ninfer::ops::gguf::detail::vec;
+
+template <int T, bool Fused, int KS, bool Cooperative>
+__launch_bounds__(detail::kVecWarps * 32) __global__ void q6k_static_kernel(detail::VecArgs p) {
+    using D = upstream::Q6Decoder;
+    constexpr int kPerBlock = D::kBlockElems / 32;
+    constexpr int kRowsPerLaneGroup = 2;
+    constexpr int kStaticSlices = KS / 32;
+    constexpr int kStaticIterations = (kStaticSlices + 31) / 32;
+    static_assert(KS == 2560 || KS == 6144 || KS == 10240);
+
+    const int warp = threadIdx.x >> 5;
+    const int lane = threadIdx.x & 31;
+    constexpr int step = Fused ? 1 : kRowsPerLaneGroup;
+    constexpr int slices = kStaticSlices;
+    const std::int64_t lane_offset = std::int64_t(lane / kPerBlock) * D::kBlockBytes;
+    const int sub = lane % kPerBlock;
+
+    for (int row0 = (blockIdx.x * detail::kVecWarps + warp) * step; row0 < p.rows;
+         row0 += gridDim.x * detail::kVecWarps * step) {
+        const std::uint8_t* rowp[kRowsPerLaneGroup];
+        if constexpr (Fused) {
+            rowp[0] = p.weight + std::int64_t(row0) * p.row_bytes + lane_offset;
+            rowp[1] = p.weight + std::int64_t(p.rows + row0) * p.row_bytes + lane_offset;
+        } else {
+#pragma unroll
+            for (int r = 0; r < kRowsPerLaneGroup; ++r) {
+                rowp[r] = p.weight + std::int64_t(min(row0 + r, p.rows - 1)) * p.row_bytes + lane_offset;
+            }
+        }
+        float acc[kRowsPerLaneGroup][T];
+#pragma unroll
+        for (int r = 0; r < kRowsPerLaneGroup; ++r) {
+#pragma unroll
+            for (int j = 0; j < T; ++j) { acc[r][j] = 0.0f; }
+        }
+        const auto slice = [&](int it) {
+            const int s = lane + 32 * it;
+            int a[T][8];
+            float d[T], sum[T];
+#pragma unroll
+            for (int j = 0; j < T; ++j) {
+                const float2 ds = __half22float2(p.ds[std::int64_t(j) * slices + s]);
+                d[j] = ds.x;
+                sum[j] = ds.y;
+                const auto* q = reinterpret_cast<const int4*>(p.qs + std::int64_t(j) * KS + 32 * s);
+                const int4 v0 = q[0], v1 = q[1];
+                a[j][0] = v0.x; a[j][1] = v0.y; a[j][2] = v0.z; a[j][3] = v0.w;
+                a[j][4] = v1.x; a[j][5] = v1.y; a[j][6] = v1.z; a[j][7] = v1.w;
+            }
+#pragma unroll
+            for (int r = 0; r < kRowsPerLaneGroup; ++r) {
+                vec::Slice decoded;
+                D::template decode<Cooperative>(rowp[r] + std::int64_t(32 / kPerBlock) * it * D::kBlockBytes,
+                                                 sub, nullptr, decoded);
+#pragma unroll
+                for (int j = 0; j < T; ++j) { acc[r][j] += D::dot(decoded, a[j], d[j], sum[j]); }
+            }
+        };
+
+        if constexpr (KS == 2560) {
+            // 80 slices = two full 32-lane chunks plus a third chunk for lanes 0..15 only.
+#pragma unroll
+            for (int it = 0; it < kStaticIterations; ++it) {
+                if (lane + 32 * it < kStaticSlices) { slice(it); }
+            }
+        } else {
+            static_assert(KS % 1024 == 0);
+#pragma unroll
+            for (int it = 0; it < kStaticIterations; ++it) { slice(it); }
+        }
+
+#pragma unroll
+        for (int r = 0; r < kRowsPerLaneGroup; ++r) {
+#pragma unroll
+            for (int j = 0; j < T; ++j) {
+#pragma unroll
+                for (int offset = 16; offset > 0; offset >>= 1) {
+                    acc[r][j] += __shfl_xor_sync(0xFFFFFFFFu, acc[r][j], offset);
+                }
+            }
+        }
+        if (lane == 0) {
+            if constexpr (Fused) {
+#pragma unroll
+                for (int j = 0; j < T; ++j) {
+                    detail::vec_store(p.out, row0, j,
+                                      detail::vec_gate(acc[0][j], p.out.activation) * acc[1][j]);
+                }
+            } else {
+#pragma unroll
+                for (int r = 0; r < kRowsPerLaneGroup; ++r) {
+                    if (row0 + r < p.rows) {
+#pragma unroll
+                        for (int j = 0; j < T; ++j) { detail::vec_store(p.out, row0 + r, j, acc[r][j]); }
+                    }
+                }
+            }
+        }
+    }
+}
+
+template <int T, bool Fused, int KS, bool Cooperative>
+int resident_blocks() {
+    static const int resident = [] {
+        int blocks = 0;
+        const auto status = cudaOccupancyMaxActiveBlocksPerMultiprocessor(
+            &blocks, q6k_static_kernel<T, Fused, KS, Cooperative>, detail::kVecWarps * 32, 0);
+        if (status != cudaSuccess) {
+            throw std::runtime_error(std::string("Q6_K candidate occupancy: ") +
+                                     cudaGetErrorString(status));
+        }
+        return std::max(blocks, 1);
+    }();
+    return resident;
+}
+
+template <int T, bool Fused, int KS, bool Cooperative>
+void launch(const detail::VecArgs& args, cudaStream_t stream) {
+    const int resident = resident_blocks<T, Fused, KS, Cooperative>();
+    const int per_block = detail::kVecWarps * (Fused ? 1 : 2);
+    const int groups = (args.rows + per_block - 1) / per_block;
+    // Reuse the GGUF bridge's per-device property cache, matching its production vector launcher.
+    // In particular, do not query cudaDeviceGetAttribute on every decode dispatch / graph replay.
+    const int sms = detail::device_facts().sm_count;
+    const int blocks = std::min(groups, resident * std::max(sms, 1));
+    q6k_static_kernel<T, Fused, KS, Cooperative><<<blocks, detail::kVecWarps * 32, 0, stream>>>(args);
+    const auto status = cudaGetLastError();
+    if (status != cudaSuccess) {
+        throw std::runtime_error(std::string("Q6_K candidate launch: ") + cudaGetErrorString(status));
+    }
+}
+
+template <int T, int KS>
+void prepare_product() { (void)resident_blocks<T, false, KS, true>(); }
+
+template <bool Fused, int KS, bool Cooperative>
+void dispatch_columns(const detail::VecArgs& args, int columns, cudaStream_t stream) {
+    switch (columns) {
+    case 1: return launch<1, Fused, KS, Cooperative>(args, stream);
+    case 3: return launch<3, Fused, KS, Cooperative>(args, stream);
+    case 4: return launch<4, Fused, KS, Cooperative>(args, stream);
+    case 8: return launch<8, Fused, KS, Cooperative>(args, stream);
+    default: throw std::invalid_argument("Q6_K cooperative route supports columns 1, 3, 4, 8");
+    }
+}
+
+template <bool Fused, bool Cooperative>
+void dispatch_shape(const detail::VecArgs& args, int columns, cudaStream_t stream) {
+    switch (args.k) {
+    case 2560: return dispatch_columns<Fused, 2560, Cooperative>(args, columns, stream);
+    case 6144: return dispatch_columns<Fused, 6144, Cooperative>(args, columns, stream);
+    case 10240: return dispatch_columns<Fused, 10240, Cooperative>(args, columns, stream);
+    default: throw std::invalid_argument("Q6_K candidate supports K=2560, 6144, 10240");
+    }
+}
+
+detail::VecArgs make_args(const void* weight, std::int64_t row_bytes, int rows, int k,
+                          const void* activation, int columns, const detail::VecStore& out) {
+    if (!weight || !activation || rows <= 0 || columns < 1 || columns > gguf::kMaxVectorColumns ||
+        (k != 2560 && k != 6144 && k != 10240) || k % 256 != 0 ||
+        row_bytes != std::int64_t(k / 256) * 210) {
+        throw std::invalid_argument("Q6_K candidate: unsupported shape or missing input");
+    }
+    const auto* base = static_cast<const std::uint8_t*>(activation);
+    return detail::VecArgs{static_cast<const std::uint8_t*>(weight), row_bytes, rows, k,
+                           reinterpret_cast<const std::int8_t*>(base),
+                           reinterpret_cast<const half2*>(base + gguf::vector_activation_scales_offset(k, columns)),
+                           out};
+}
+
+} // namespace
+
+bool q6k_cooperative_available() { return detail::device_facts().cc == 1100; }
+
+void q6k_cooperative_prepare() {
+    // Warm all production cooperative/unfused occupancy specializations during workspace planning,
+    // before graph capture. This launches no GPU work and leaves scalar/SwiGLU out of production.
+    prepare_product<1, 2560>(); prepare_product<3, 2560>();
+    prepare_product<4, 2560>(); prepare_product<8, 2560>();
+    prepare_product<1, 6144>(); prepare_product<3, 6144>();
+    prepare_product<4, 6144>(); prepare_product<8, 6144>();
+    prepare_product<1, 10240>(); prepare_product<3, 10240>();
+    prepare_product<4, 10240>(); prepare_product<8, 10240>();
+}
+
+void q6k_cooperative_product(const void* weight, std::int64_t row_bytes, int rows, int k,
+                             const void* q8_activation, int columns,
+                             const gguf::VectorOutput& out, cudaStream_t stream) {
+    if ((out.bf16 == nullptr) == (out.f32 == nullptr) ||
+        (out.epilogue == gguf::Epilogue::GateProduct && out.gate == nullptr)) {
+        throw std::invalid_argument("Q6_K candidate: invalid output");
+    }
+    const detail::VecStore store{out.bf16, out.f32, out.column_stride, out.epilogue,
+                                 out.gate, out.gate_column_stride, static_cast<int>(out.activation)};
+    dispatch_shape<false, true>(make_args(weight, row_bytes, rows, k, q8_activation, columns, store),
+                                columns, stream);
+}
+
+} // namespace ninfer::q6k_cooperative
