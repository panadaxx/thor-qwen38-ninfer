+// Runtime guard consults the existing GGUF bridge DeviceFacts cache; cc is stored as 100*major+10*minor.
+bool q6k_cooperative_available();
+// Run during workspace planning before graph capture to cache cooperative T/K occupancy variants.
+void q6k_cooperative_prepare();
+void q6k_cooperative_product(const void* weight, std::int64_t row_bytes, int rows, int k,
+                             const void* q8_activation, int columns,
+                             const ninfer::ops::gguf::VectorOutput& out, cudaStream_t stream);
+}
