+            std::to_string(x.ne[1]) + " type=" + std::to_string(static_cast<int>(w.qtype)) +
+            " out_contiguous=" + std::to_string(out.is_contiguous()) +
+            " out_dtype=" + std::to_string(static_cast<int>(out.dtype)) +
+            " out_n=" + std::to_string(out.ne[0]) + " out_t=" + std::to_string(out.ne[1]) +
+            " weight_n=" + std::to_string(w.n) + " weight_k=" + std::to_string(w.k) +
