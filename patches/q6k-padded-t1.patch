+// Same Q6_K arithmetic/scale grouping as q6k_cooperative::upstream::Q6Decoder. The only storage
+// changes are a 212-byte padded block stride and aligned u32_a4 loads for ql/qh words.
+struct Q6AlignedDecoder {
+    static constexpr int kBlockBytes = 212;
+
+    __device__ __forceinline__ static void decode(const std::uint8_t* b, int u, vec::Slice& s) {
+        const int h = u / 4, q = u % 4;
+        const float d = vec::half_at(b + 208);
+        const auto* sc = reinterpret_cast<const std::int8_t*>(b + 192 + 8 * h);
+        s.f[0] = d * float(sc[2 * q]);
+        s.f[1] = d * float(sc[2 * q + 1]);
+        const std::uint8_t* ql = b + 64 * h + 32 * (q & 1);
+        const std::uint8_t* qh = b + 128 + 32 * h;
+        const unsigned mask = 0xFu << (threadIdx.x & 28);
+#pragma unroll
+        for (int base = 0; base < 8; base += 4) {
+            const std::uint32_t hi = vec::u32_a4(qh + 4 * (base + q));
+            const std::uint32_t lo0 = vec::u32_a4(ql + 4 * (base + (q >> 1)));
+            const std::uint32_t lo1 = vec::u32_a4(ql + 4 * (base + 2 + (q >> 1)));
+#pragma unroll
+            for (int j = 0; j < 4; ++j) {
+                const std::uint32_t high = __shfl_sync(mask, hi, j, 4);
+                const std::uint32_t low = __shfl_sync(mask, j < 2 ? lo0 : lo1,
+                                                       (q & 1) + 2 * (j & 1), 4);
+                const std::uint32_t v = ((low >> (4 * (q >> 1))) & 0x0F0F0F0Fu) |
+                                        (((high >> (2 * q)) << 4) & 0x30303030u);
+                s.w[base + j] = int(v ^ 0xE0E0E0E0u ^ ((v & 0x20202020u) * 6u));
+            }
+        }
+    }
+
+    __device__ __forceinline__ static float dot(const vec::Slice& s, const int* a, float d) {
+        return __fmul_rn(d, __fadd_rn(__fmul_rn(s.f[0], float(vec::dot4(s.w, a, 0))),
+                                      __fmul_rn(s.f[1], float(vec::dot4(s.w + 4, a + 4, 0)))));
+    }
+};
+
+inline constexpr int kWarps = detail::kVecWarps;
+
+__launch_bounds__(kWarps * 32) __global__ void q6_aligned_t1_kernel(detail::VecArgs p, int k) {
+    constexpr int kRowsPerLaneGroup = 2;
+    const int lane = int(threadIdx.x) & 31;
+    const int warp = int(threadIdx.x) >> 5;
+    const int slices = k / 32;
+    const int block_in_row = lane / 8;
+    const std::int64_t row_offset = std::int64_t(block_in_row) * Q6AlignedDecoder::kBlockBytes;
+    for (int row0 = (int(blockIdx.x) * kWarps + warp) * kRowsPerLaneGroup;
+         row0 < p.rows; row0 += int(gridDim.x) * kWarps * kRowsPerLaneGroup) {
+        const std::uint8_t* rowp[2] = {
+            p.weight + std::int64_t(row0) * p.row_bytes + row_offset,
+            p.weight + std::int64_t(min(row0 + 1, p.rows - 1)) * p.row_bytes + row_offset};
+        float acc[2] = {0.0f, 0.0f};
+        for (int it = 0; lane + 32 * it < slices; ++it) {
+            const int s = lane + 32 * it;
+            const auto* activation = reinterpret_cast<const int4*>(p.qs + 32 * s);
+            const int4 a0 = activation[0], a1 = activation[1];
+            const int a[8] = {a0.x, a0.y, a0.z, a0.w, a1.x, a1.y, a1.z, a1.w};
+            const float d = __half22float2(p.ds[s]).x;
+#pragma unroll
+            for (int r = 0; r < 2; ++r) {
+                vec::Slice decoded;
+                const std::uint8_t* block = rowp[r] + std::int64_t(4 * it) * Q6AlignedDecoder::kBlockBytes;
+                Q6AlignedDecoder::decode(block, s & 7, decoded);
+                acc[r] += Q6AlignedDecoder::dot(decoded, a, d);
+            }
+        }
+#pragma unroll
+        for (int r = 0; r < 2; ++r) {
+#pragma unroll
+            for (int offset = 16; offset > 0; offset >>= 1) {
+                acc[r] += __shfl_xor_sync(0xFFFFFFFFu, acc[r], offset);
+            }
+        }
+        if (lane == 0) {
+            if (row0 < p.rows) { detail::vec_store(p.out, row0, 0, acc[0]); }
+            if (row0 + 1 < p.rows) { detail::vec_store(p.out, row0 + 1, 0, acc[1]); }
+        }
+    }
